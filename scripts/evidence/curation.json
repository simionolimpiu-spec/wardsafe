  "33309843": {
    "cueTypes": [
      "sepsis-screen",
      "staffing-context"
    ],
    "verification": "abstract-read",
    "safeflowSummary": "Using 2017 US hospital data, this study found each additional patient per nurse was associated with 12% higher in-hospital mortality and 7% higher 60-day mortality and readmission for sepsis patients, even after accounting for hospitals' adherence to sepsis-bundle protocols. Protocol adherence mattered, but its effect on outcomes was clearly smaller than the effect attributed to staffing levels in this analysis. SafeFlow surfaces staffing context alongside clinical cues because this evidence suggests workload is a first-order factor in sepsis outcomes, not just a background variable."
  },

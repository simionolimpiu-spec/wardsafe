{
  "name": "safeflow-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "infra:synth": "cdk synth --quiet -c safeFlowOperation=synth",
    "infra:synth:dev": "cdk synth --quiet -c safeFlowOperation=synth -c safeflowEnvironment=dev",
    "infra:synth:simulation": "cdk synth --quiet -c safeFlowOperation=synth -c safeflowEnvironment=simulation",
    "db:manifest": "node database/printMigrationManifest.js",
    "db:migrate:plan": "node database/runMigrations.js --dry-run",
    "db:migrate:execute": "node database/runMigrations.js --execute",
    "preview": "vite preview --host 127.0.0.1",
    "api:smoke": "node server/apiSmoke.js",
    "api": "node server/index.js"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "openai": "^6.43.0",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^5.1.0",
    "aws-cdk": "^2.1128.0",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "jsdom": "^27.3.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}

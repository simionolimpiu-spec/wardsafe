{
  "name": "safeflow-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run --passWithNoTests --config ./vitest.config.js",
    "ml:generate-dataset": "node ml/generateSyntheticDataset.js",
    "ml:train": "node ml/trainSimulatedTrendModel.js",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "infra:synth": "node infra/aws/runSynth.js",
    "infra:synth:dev": "node infra/aws/runSynth.js --environment=dev",
    "infra:synth:simulation": "node infra/aws/runSynth.js --environment=simulation",
    "infra:deploy:preflight": "node infra/aws/deploymentPreflight.js",
    "infra:diff:simulation": "npm run infra:deploy:preflight && cdk diff -c safeFlowOperation=deploy -c safeflowEnvironment=simulation",
    "infra:deploy:simulation": "npm run infra:deploy:preflight && cdk deploy -c safeFlowOperation=deploy -c safeflowEnvironment=simulation",
    "db:manifest": "node database/printMigrationManifest.js",
    "db:migrate:plan": "node database/runMigrations.js --dry-run",
    "db:migrate:execute": "node database/runMigrations.js --execute",
    "preview": "vite preview --host 127.0.0.1",
    "api:smoke": "node server/apiSmoke.js",
    "api:smoke:preview": "node infra/aws/previewApiSmoke.js",
    "api": "node server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1075.0",
    "@fontsource/inter": "^5.2.8",
    "chart.js": "^4.5.1",
    "lucide-react": "^0.561.0",
    "openai": "^6.43.0",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^5.1.0",
    "aws-cdk": "^2.1128.0",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "jsdom": "^27.3.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}

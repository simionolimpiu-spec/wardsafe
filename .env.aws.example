# SafeFlow AWS simulation deployment template.
# Copy values into your local shell/profile; do not commit real credentials.

AWS_PROFILE=safeflow-free-tier
AWS_REGION=eu-west-2
CDK_DEFAULT_REGION=eu-west-2
SAFEFLOW_ENVIRONMENT=simulation
SAFEFLOW_SIMULATION_ONLY=true
SAFEFLOW_ACCOUNT_MFA_CONFIRMED=true
SAFEFLOW_BUDGET_CONFIRMED=true

# Keep false until you are intentionally running cdk diff/deploy.
SAFEFLOW_DEPLOYMENT_APPROVED=false

# Set by AWS CLI/CDK after you configure credentials or run aws sts get-caller-identity.
# CDK_DEFAULT_ACCOUNT=123456789012

# Optional runtime provider settings. Never commit real keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
